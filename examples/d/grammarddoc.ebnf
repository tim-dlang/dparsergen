Ddoc = Element2*;


Element = <Text | <WysiwygString | <Macro | <NL | <WS | <Comma | <Parens;
Element2 = <Text | <WysiwygString | <Macro | <NL | <WS | <Comma | <LonelyParen;

Macro = "$(" Text2 Element* ")";
Text = Text2 | "$";
WysiwygString = WysiwygString2;
Parens = "(" Element* ")";
LonelyParen = "(" | ")";
NL = "\n";
Comma = ",";

token Text2 = [^ \t\n()$,`]+;
token WysiwygString2 = "`" [^`]* "`";
WS = WST;
token WST = [ \t]+;
